# PrepWise Frontend (.env.local)
# Copy this file to .env.local (recommended) and fill in your own values.

# ==============================
# API
# ==============================
# Base origin for the backend (frontend app will call ${NEXT_PUBLIC_API_URL}/api/*)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# ==============================
# Database (used by Prisma client in Next.js server runtime)
# ==============================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ==============================
# Clerk Auth
# ==============================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ==============================
# Grok AI (server-side)
# ==============================
GROK_API_KEY=""
GROK_BASE_URL="https://api.groq.com/openai/v1"
GROK_MODEL="grok-3-mini"

# ==============================
# VAPI Voice AI
# ==============================
VAPI_API_KEY=""
NEXT_PUBLIC_VAPI_API_KEY=""
# Optional: pre-created assistant id
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""
# Optional: model override used by frontend/lib/services/vapi.service.ts
VAPI_MODEL="grok-3-mini"

# ==============================
# GetStream Video
# ==============================
STREAM_API_KEY=""
STREAM_SECRET=""
NEXT_PUBLIC_STREAM_API_KEY=""

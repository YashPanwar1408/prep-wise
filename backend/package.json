{
  "name": "interview-platform-backend",
  "version": "1.0.0",
  "description": "Backend for Interview Platform",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:fullstack": "node prisma/seedFullStack.js",
    "sync:aiml-content": "node prisma/syncAIMLContent.js",
    "seed:roadmaps": "node prisma/seedRoadmaps.js",
    "seed:cheatsheets": "node prisma/seedCheatsheets.js",
    "seed:content": "node prisma/seedRoadmaps.js && node prisma/seedCheatsheets.js",
    "seed:testcases": "node prisma/seedTestCases.js",
    "seed:solutions": "node prisma/seedSolution.js",
    "seed:problems": "node prisma/seedPatterns.js && node prisma/seedMaster250.js && node prisma/seedSolution.js && node prisma/seedTestCases.js"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "pdf-parse": "^2.4.5",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.1.11",
    "prisma": "^5.9.1"
  },
  "prisma": {
    "seed": "node prisma/seedFullStack.js"
  }
}

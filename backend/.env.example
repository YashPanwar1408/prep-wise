# PrepWise Backend (.env)
# Copy this file to .env and fill in your own values.

# ==============================
# Server
# ==============================
PORT=5000

# ==============================
# Database (PostgreSQL)
# Prisma consumes DATABASE_URL and (optionally) DIRECT_URL
# ==============================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ==============================
# Auth (JWT)
# ==============================
JWT_SECRET=change-me-in-production

# ==============================
# AI (Grok / Groq OpenAI-compatible endpoint)
# Used by backend/lib/grok.utils.js and ATS endpoints
# ==============================
GROK_API_KEY=
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=grok-3-mini

# ==============================
# Code Judge (local/docker runner)
# ==============================
# If USE_DOCKER is not 'false', the judge will try Docker for python/js.
USE_DOCKER=true
# Optional: use Piston cloud runner instead of local/docker
USE_PISTON=false
# Local execution timeout per test-case (ms)
JUDGE_CMD_TIMEOUT_MS=30000

# ==============================
# Judge0 Execution Engine (/api/execution)
# RapidAPI-hosted Judge0 CE or self-hosted instance
# ==============================
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Execution limits applied per test-case (optional)
JUDGE0_CPU_LIMIT=5
JUDGE0_MEM_LIMIT=131072
